# Plantilla de credenciales de firma para el release de Android.
#
# COPIAR este archivo a `android/keystore.properties` y completar con los
# valores reales. `keystore.properties` está gitignored: NUNCA se commitea,
# igual que el .jks/.keystore. Guardá estos datos en un gestor de secretos.
#
# Para crear la keystore (una sola vez; elegí vos las contraseñas):
#   keytool -genkey -v -keystore conectoca-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias conectoca
#
# `storeFile` es la ruta al .jks, relativa a android/app/ (o absoluta).

storeFile=conectoca-release.jks
storePassword=CAMBIAR
keyAlias=conectoca
keyPassword=CAMBIAR
