<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: los enlaces de los correos de cuenta
                 (https://<host>/?cuenta=...) abren la app en vez del navegador.
                 Solo la raíz "/": los QR de reclamos (/opina, /reclamos) siguen
                 abriendo la web. El host sale de build.gradle (appLinksHost).
                 autoVerify exige que el sitio publique
                 /.well-known/assetlinks.json con la huella de la llave de firma
                 (docs/enlaces-app.md); mientras no esté, Android abre el
                 navegador como hasta ahora. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinksHost}" android:path="/" />
            </intent-filter>

            <!-- Esquema propio, para probar los enlaces sin dominio verificado
                 (adb shell am start -d 'info.laoca.app://cuenta?...'). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="info.laoca.app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cámara: la usa el escáner de códigos de barras
         (src/components/BarcodeScannerDialog.tsx). Sin este permiso el WebView
         no puede abrir la cámara y getUserMedia falla. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- La cámara no es obligatoria para instalar: el resto de la app funciona
         sin ella, así que no se excluye a dispositivos sin cámara del Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
