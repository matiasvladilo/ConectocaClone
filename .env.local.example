# Copia este archivo a .env.local y completa los valores del nuevo proyecto conectocadev
# NUNCA subas .env.local al repositorio

# URL del nuevo proyecto Supabase (conectocadev)
VITE_SUPABASE_URL=https://TU_NUEVO_PROJECT_ID.supabase.co

# Clave anónima del nuevo proyecto Supabase
VITE_SUPABASE_ANON_KEY=eyJ...

# Origen público permanente de Conectoca. El QR de reclamos apunta a <este valor>/reclamos.
# Debe coincidir con el secreto APP_PUBLIC_URL de la Edge Function "complaints".
VITE_APP_PUBLIC_URL=https://conectocadev.netlify.app
